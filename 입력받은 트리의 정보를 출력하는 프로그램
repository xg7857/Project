#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_LEN   100000
#define MAX_NODES 26

static char input[MAX_LEN];
static int  len;

static int  totalNodes  = 0;
static int  leafNodes   = 0;
static int  maxDepth    = 0;
static int  maxDegree   = 0;

static int  foundC      = 0;
static int  cIsRoot     = 0;
static char parentOfC   = 0;
static char childrenOfC[MAX_NODES];
static int  childrenOfCCount = 0;

static int  isLastChild[MAX_NODES];

static void error_exit(const char *msg) {
    printf("[오류] %s\n", msg);
    exit(0);
}

static int isNodeChar(char c) {
    return c >= 'A' && c <= 'Z';
}

static void clean_input(void) {
    len = (int)strlen(input);
    while (len > 0 && (input[len-1] == '\n' || input[len-1] == '\r' || input[len-1] == ' ')) {
        input[--len] = '\0';
    }
    char tmp[MAX_LEN];
    int j = 0;
    for (int i = 0; i < len; i++) {
        if (input[i] != ' ' && input[i] != '\t') tmp[j++] = input[i];
    }
    tmp[j] = '\0';
    strcpy(input, tmp);
    len = j;
}

static void parse_and_analyze(void) {
    char nodeStack[MAX_NODES];
    int  idxStack[MAX_NODES];
    int  childCountStack[MAX_NODES];
    int  stackTop = -1;

    int used[26] = {0};
    int order = 0;

    enum { EXPECT_NODE, EXPECT_AFTER_NODE } state = EXPECT_NODE;

    int i = 0;
    while (i < len) {
        char c = input[i];

        if (isNodeChar(c)) {
            if (state != EXPECT_NODE)
                error_exit("노드가 나올 수 없는 위치에 노드 문자가 있습니다.");

            int letterIdx = c - 'A';
            if (used[letterIdx])
                error_exit("같은 이름의 노드가 두 번 이상 사용되었습니다.");
            used[letterIdx] = 1;

            totalNodes++;
            int depth = stackTop + 1;
            if (depth > maxDepth) maxDepth = depth;

            char parent = (stackTop >= 0) ? nodeStack[stackTop] : 0;
            if (c == 'C') {
                foundC   = 1;
                parentOfC = parent;
                cIsRoot  = (stackTop < 0);
            }
            if (parent == 'C') {
                childrenOfC[childrenOfCCount++] = c;
            }

            int myOrder = order++;

            if (i + 1 < len && input[i + 1] == '(') {
                if (stackTop + 1 >= MAX_NODES)
                    error_exit("노드 개수가 너무 많습니다.");
                stackTop++;
                nodeStack[stackTop]       = c;
                idxStack[stackTop]        = myOrder;
                childCountStack[stackTop] = 0;
                i += 2;
                state = EXPECT_NODE;
                continue;
            } else {
                leafNodes++;
                if (i + 1 >= len || input[i + 1] == ')')
                    isLastChild[myOrder] = 1;
                else
                    isLastChild[myOrder] = 0;
                i++;
                state = EXPECT_AFTER_NODE;
                continue;
            }
        } else if (c == ',') {
            if (state != EXPECT_AFTER_NODE)
                error_exit("',' 의 위치가 올바르지 않습니다.");
            if (stackTop < 0)
                error_exit("최상위 레벨에는 ',' 가 올 수 없습니다.");
            childCountStack[stackTop]++;
            state = EXPECT_NODE;
            i++;
            continue;
        } else if (c == ')') {
            if (state != EXPECT_AFTER_NODE)
                error_exit("')' 의 위치가 올바르지 않습니다.");
            if (stackTop < 0)
                error_exit("괄호의 짝이 맞지 않습니다.");
            childCountStack[stackTop]++;
            if (childCountStack[stackTop] > maxDegree)
                maxDegree = childCountStack[stackTop];

            int myOrder = idxStack[stackTop];
            if (i + 1 >= len || input[i + 1] == ')')
                isLastChild[myOrder] = 1;
            else
                isLastChild[myOrder] = 0;

            stackTop--;
            state = EXPECT_AFTER_NODE;
            i++;
            continue;
        } else {
            error_exit("허용되지 않는 문자가 포함되어 있습니다. (노드는 A~Z 대문자만 가능)");
        }
    }

    if (state != EXPECT_AFTER_NODE)
        error_exit("입력이 완전한 노드로 끝나지 않았습니다.");
    if (stackTop != -1)
        error_exit("괄호의 짝이 맞지 않습니다.");
    if (totalNodes == 0)
        error_exit("트리에 노드가 없습니다.");
}

static void print_tree_basic(void) {
    int  dtop = -1;
    int  i = 0;

    while (i < len) {
        char c = input[i];
        if (isNodeChar(c)) {
            int depth = dtop + 1;
            if (depth == 0) {
                printf("%c\n", c);
            } else {
                for (int s = 0; s < depth - 1; s++) printf("    ");
                printf("+---%c\n", c);
            }
            if (i + 1 < len && input[i + 1] == '(') {
                dtop++;
                i += 2;
            } else {
                i++;
            }
        } else if (c == ',') {
            i++;
        } else {
            dtop--;
            i++;
        }
    }
}

static void print_tree_with_bars(void) {
    int lastFlagStack[MAX_NODES];
    int dtop = -1;
    int i = 0;
    int order = 0;

    while (i < len) {
        char c = input[i];
        if (isNodeChar(c)) {
            int depth = dtop + 1;
            int myOrder = order++;

            if (depth == 0) {
                printf("%c\n", c);
            } else {
                for (int g = 0; g < depth - 1; g++) {
                    if (lastFlagStack[g + 1] == 0) printf("|   ");
                    else                            printf("    ");
                }
                printf("+---%c\n", c);
            }

            if (i + 1 < len && input[i + 1] == '(') {
                dtop++;
                lastFlagStack[dtop] = isLastChild[myOrder];
                i += 2;
            } else {
                i++;
            }
        } else if (c == ',') {
            i++;
        } else {
            dtop--;
            i++;
        }
    }
}

int main(void) {
    printf("트리를 괄호 표기법으로 입력하세요: ");
    if (!fgets(input, sizeof(input), stdin))
        error_exit("입력을 읽을 수 없습니다.");

    clean_input();
    if (len == 0) error_exit("입력이 비어 있습니다.");

    parse_and_analyze();

    int nonLeaf = totalNodes - leafNodes;
    int height  = maxDepth + 1;

    printf("\n===== 트리 정보 =====\n");
    printf("전체 노드의 수   : %d\n", totalNodes);
    printf("단말 노드의 수   : %d\n", leafNodes);
    printf("비단말 노드의 수 : %d\n", nonLeaf);
    printf("트리의 높이      : %d\n", height);
    printf("트리의 차수      : %d\n", maxDegree);

    if (!foundC) {
        printf("노드 C          : 트리에 존재하지 않습니다.\n");
    } else {
        if (cIsRoot)
            printf("노드 C의 부모   : 없음 (루트 노드)\n");
        else
            printf("노드 C의 부모   : %c\n", parentOfC);

        printf("노드 C의 자식   : ");
        if (childrenOfCCount == 0) {
            printf("없음 (단말 노드)\n");
        } else {
            for (int k = 0; k < childrenOfCCount; k++) {
                printf("%c", childrenOfC[k]);
                if (k != childrenOfCCount - 1) printf(", ");
            }
            printf("\n");
        }
    }

    printf("\n===== 트리 구조 (기본형) =====\n");
    print_tree_basic();

    printf("\n===== 트리 구조 (참고: '|' 포함) =====\n");
    print_tree_with_bars();

    return 0;
}
